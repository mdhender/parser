#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

echo 'Checking system build tools'
missing=()
for package in ca-certificates curl build-essential diffutils tar gzip; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -qx 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi
echo "System build tools ready (${SECONDS}s elapsed)"

version="$(awk '$1 == "go" { print $2 }' go.mod)"
go_root="/usr/local/lib/go${version}"
echo "Preparing Go ${version}"
if [[ ! -x "$go_root/bin/go" ]]; then
  # The archive and checksum are pinned together with the go.mod toolchain version.
  case "${version}:$(uname -m)" in
    1.27.3:x86_64)
      archive="go${version}.linux-amd64.tar.gz"
      checksum=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
      ;;
    *) echo "Unsupported Go version or architecture: ${version}:$(uname -m)" >&2; exit 1 ;;
  esac
  temp_dir="$(mktemp -d)"
  trap 'rm -rf "$temp_dir"' EXIT
  curl --fail --silent --show-error --location --retry 3 "https://go.dev/dl/$archive" -o "$temp_dir/$archive"
  echo "$checksum  $temp_dir/$archive" | sha256sum --check
  tar -xzf "$temp_dir/$archive" -C "$temp_dir"
  sudo mkdir -p /usr/local/lib
  sudo mv "$temp_dir/go" "$go_root"
fi
# /usr/local/bin is available to agents and services, not just this setup shell.
sudo ln -sfn "$go_root/bin/go" /usr/local/bin/go
sudo ln -sfn "$go_root/bin/gofmt" /usr/local/bin/gofmt
"$go_root/bin/go" version
echo "Go ready (${SECONDS}s elapsed)"

echo 'Downloading Go module dependencies'
GOTOOLCHAIN=local "$go_root/bin/go" mod download
echo "Orb setup finished (${SECONDS}s elapsed)"
